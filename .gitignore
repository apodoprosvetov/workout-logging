# Dependencies
node_modules/

# Build output
dist/
build/
.next/
*.tsbuildinfo

# Environment (secrets, FR-019) — .env.example is the tracked template, kept
.env
.env.local
.env.*.local

# Testing
coverage/

# Terraform (specs/002-deployment-cicd) — state can contain sensitive values.
# .terraform.lock.hcl is NOT ignored — Terraform's own guidance is to commit
# it, so `terraform init` pins the same provider version/hash everywhere.
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
crash.log

# Editor / OS
.DS_Store
.vscode/
.idea/

# Logs
*.log
npm-debug.log*
