# Copy this file to `.env` and fill in real values. Never commit `.env` (FR-019).
# Connection strings below match docker-compose.yml's default credentials —
# override both together if you change one.
#
# PRODUCTION does not use this file. Runtime secrets live in AWS Systems Manager
# Parameter Store under /workout-logging/* and are injected by deploy.yml just
# before `docker compose up` (spec 002, research.md #10). Keep the names here in
# sync with what deploy.yml resolves:
#   Parameter Store, same name here : DATABASE_URL, MONGO_URL, RABBITMQ_URL,
#                                     JWT_SECRET, ANTHROPIC_API_KEY
#   local-only (prod differs)       : REDIS_URL       (prod hardcodes redis://redis:6379)
#                                     WEB_ORIGIN      (prod: see note below)
#                                     TELEGRAM_BOT_TOKEN (prod: not wired yet — bot unbuilt)
#   prod-only, no local entry       : POSTGRES_PASSWORD / MONGO_PASSWORD /
#                                     RABBITMQ_PASSWORD (local uses compose defaults),
#                                     DEPLOY_SSH_PRIVATE_KEY (deploy.yml git clone only)

# Postgres (users, workouts, workout_exercises, sets, exercises, ...)
DATABASE_URL=postgres://workout_logging:workout_logging@localhost:5432/workout_logging

# MongoDB (raw_uploads, exercise_catalog). authSource=admin because
# docker-compose's MONGO_INITDB_ROOT_USERNAME creates the user on the admin db.
MONGO_URL=mongodb://workout_logging:workout_logging@localhost:27017/workout_logging?authSource=admin

# Redis (rate-limit counters, cached weekly volume aggregates)
REDIS_URL=redis://localhost:6379

# RabbitMQ (workout.events topic exchange + queues, research.md #3)
RABBITMQ_URL=amqp://workout_logging:workout_logging@localhost:5672

# JWT access-token signing secret (research.md #6). Generate a real one with:
#   openssl rand -base64 32
JWT_SECRET=change-me-to-a-random-secret

# apps/web's origin, for CORS — apps/api only accepts browser fetch() calls from
# this origin (apps/api/src/main.ts, defaults to http://localhost:3001 if unset).
# Matches apps/web/package.json's `dev -p 3001`.
# PROD: currently unset, so it falls back to the localhost default. Harmless only
# because apps/web calls the API same-origin (/api) through CloudFront, which
# never triggers a CORS check. Set to https://<cloudfront-domain> if a real
# cross-origin caller is ever added.
WEB_ORIGIN=http://localhost:3001

# Telegram bot token from @BotFather (research.md #5, used for the webhook bot)
TELEGRAM_BOT_TOKEN=

# DeepSeek API key (research.md #9 — this project uses @anthropic-ai/sdk pointed
# at DeepSeek's Anthropic-compatible endpoint, not a real Anthropic key; exercise/
# set extraction from text and images, research.md #7)
ANTHROPIC_API_KEY=
